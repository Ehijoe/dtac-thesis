	keywords = {bot detection, Accuracy, Authentication, behavioural biometrics, Biological system modeling, CAPTCHA, CAPTCHAs, Cloud computing, heuristic analysis, human verification, keystroke dynamics, Keystroke dynamics, mouse movement, offline authentication, Real-time systems, Scalability, System verification, Usability},
	pages = {1--6},
	file = {PDF:/home/ehijoe/Zotero/storage/8NX6GURK/Parida et al. - 2025 - Lightweight Bot Detection via Heuristic-Based Behavioural and CAPTCHA Integration.pdf:application/pdf;Snapshot:/home/ehijoe/Zotero/storage/SSDD2DCX/11234219.html:text/html},
