	year = {2025},
	keywords = {bot detection, user behavior, web bots, website navigation},
	pages = {49--67},
	file = {Preprint PDF:/home/ehijoe/Zotero/storage/WT5B9EBY/Kadel et al. - 2024 - BOTracle A framework for Discriminating Bots and Humans.pdf:application/pdf},
